<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: not to the cloud backup, not to a new phone during a transfer
     (allowBackup="false" alone doesn't stop device-to-device migration on Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
