# Papote — copy to .env and adjust. Lines starting with # are examples or optional.

# Admin web (/admin) password, at least 12 characters. Without it the admin is disabled.
# Example values and common passwords are refused.
ADMIN_PASSWORD=
# Addresses allowed to open /admin (IPs or CIDR ranges, comma separated). Elsewhere: 404.
# ADMIN_ALLOWED_IPS=192.168.0.0/16,10.0.0.0/8
# true: two-factor authentication (TOTP) must be set up before the rest of the admin is available.
ADMIN_REQUIRE_2FA=true
# Name shown in the apps
SERVER_NAME=Papote

# Host port, and on which address: 127.0.0.1 when the reverse proxy runs on this machine,
# 0.0.0.0 when it runs elsewhere.
PORT=3000
BIND_ADDRESS=127.0.0.1
# Reverse proxy addresses, the only ones allowed to set X-Forwarded-For (never a number).
# "loopback, uniquelocal" = any local or private address. Plain HTTP without a proxy: 0.
TRUST_PROXY=loopback, uniquelocal
# Admin cookies over HTTPS only. Set to false only to test over plain HTTP on your LAN.
SECURE_COOKIES=true

# Automatic backups: every N hours (0 = off), how many to keep, and where on the host
# (ideally another disk or a network share).
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
BACKUP_HOST_DIR=./backups

# Local time (birthdays, monthly recap)
TZ=Europe/Paris

# GIFs: free key on https://developers.giphy.com. Members never contact GIPHY: the server searches
# and keeps the GIFs that are sent. Empty = GIFs off (stickers still work).
GIPHY_API_KEY=

# Voice transcription (Whisper, on this machine): COMPOSE_PROFILES=whisper to turn it on.
# The image (~2 GB) is only pulled and started in that case, on the next "docker compose up -d".
COMPOSE_PROFILES=
# Whisper model: base (light), small (default), medium (more accurate, heavier). Language of voice messages.
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=fr

# Optional: admin session secret (otherwise generated in data/session.secret)
# SESSION_SECRET=
